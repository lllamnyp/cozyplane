diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index ecc7da3..04aa2ed 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -97,5 +97,3 @@ jobs:
-  # The compiled eBPF object (datapath/overlay_bpfel.*) is committed and embedded
-  # via go:embed. Regenerate it from the runner's kernel BTF and flag drift. The
-  # exact object bytes are clang-version sensitive, so this is informational
-  # (non-blocking): what it reliably guards is the generated Go bindings
-  # (map/struct layout), which must match bpf/overlay.c.
+  # Regenerate the committed eBPF object and load every tc entry point through
+  # the kernel verifier. Exact object bytes remain clang-version sensitive, but
+  # compilation and verifier acceptance are release-blocking.
@@ -104 +101,0 @@ jobs:
-    continue-on-error: true
@@ -128,0 +126,6 @@ jobs:
+      - name: kernel verifier
+        run: |
+          pin=/sys/fs/bpf/cozyplane-ci-${GITHUB_RUN_ID}
+          case "$pin" in /sys/fs/bpf/cozyplane-ci-*) ;; *) exit 2 ;; esac
+          trap 'sudo rm -rf -- "$pin"' EXIT
+          sudo bpftool prog loadall datapath/overlay_bpfel.o "$pin" type classifier
diff --git a/.github/workflows/e2e.yml b/.github/workflows/e2e.yml
index b8c48c5..77d407b 100644
--- a/.github/workflows/e2e.yml
+++ b/.github/workflows/e2e.yml
@@ -18 +18,2 @@ jobs:
-  e2e:
+  vpn-kind:
+    name: VPN (${{ matrix.backend }}) on kind
@@ -20 +21,5 @@ jobs:
-    timeout-minutes: 30
+    timeout-minutes: 45
+    strategy:
+      fail-fast: false
+      matrix:
+        backend: [wireguard, ipsec]
@@ -34,2 +39,36 @@ jobs:
-      - name: run e2e
-        run: IMAGE=ghcr.io/lllamnyp/cozyplane:e2e IMAGE_PREBUILT=1 bash test/e2e.sh
+      - name: bootstrap kind datapath e2e
+        run: IMAGE=ghcr.io/lllamnyp/cozyplane:e2e IMAGE_PREBUILT=1 KEEP=1 bash test/e2e.sh
+
+      - name: run VPN e2e
+        run: BACKEND=${{ matrix.backend }} MODE=materialize KCTX=kind-cozyplane-e2e bash test/vpn-e2e.sh
+
+      - name: collect diagnostics
+        if: failure()
+        run: kubectl --context kind-cozyplane-e2e get pods,events -A || true
+
+      - name: remove kind cluster
+        if: always()
+        run: kind delete cluster --name cozyplane-e2e || true
+
+  # This job runs only on the dedicated laboratory runner. It deliberately
+  # reuses its pre-provisioned Talos cluster; hosted runners cannot validate
+  # Talos, KubeVirt, external peers, or hardware-dependent networking.
+  vpn-lab:
+    name: VPN (${{ matrix.backend }}) in lab
+    runs-on: [self-hosted, linux, vpn-lab]
+    timeout-minutes: 45
+    strategy:
+      fail-fast: false
+      matrix:
+        backend: [wireguard, ipsec]
+    steps:
+      - uses: actions/checkout@v4
+      - name: run VPN e2e against the laboratory cluster
+        env:
+          KCTX: ${{ vars.COZYPLANE_LAB_CONTEXT }}
+        run: BACKEND=${{ matrix.backend }} MODE=live bash test/vpn-e2e.sh
+      - name: collect diagnostics
+        if: failure()
+        env:
+          KCTX: ${{ vars.COZYPLANE_LAB_CONTEXT }}
+        run: kubectl --context "$KCTX" get pods,events -A || true
